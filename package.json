{
  "name": "world-time-buddy",
  "version": "0.1.2",
  "description": "World Time Buddy — desktop timezone conversion app",
  "main": "./out/main/index.js",
  "author": "World Time Buddy",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "npm run typecheck",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:win:store": "npm run build && electron-builder --win appx --publish never",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "generate:appx-assets": "node scripts/generate-appx-assets.mjs"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "tar": "^7.5.19"
  }
}
