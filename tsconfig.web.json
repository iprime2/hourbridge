{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@core/*": [
        "src/core/*"
      ],
      "@ui/*": [
        "src/ui/*"
      ],
      "@mobile/*": [
        "src/mobile/*"
      ],
      "@renderer/*": [
        "src/renderer/src/*"
      ]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/core/**/*",
    "src/ui/**/*",
    "src/mobile/**/*",
    "src/web/**/*",
    "src/renderer/src/**/*"
  ]
}
